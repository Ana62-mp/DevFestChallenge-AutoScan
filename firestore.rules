rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed() { return request.auth != null; }
  function member(id) { return signed() && exists(/databases/$(database)/documents/communities/$(id)/members/$(request.auth.uid)); }
  function admin(id) { return member(id) && get(/databases/$(database)/documents/communities/$(id)/members/$(request.auth.uid)).data.role == 'admin'; }
  match /users/{uid} { allow read: if signed() && request.auth.uid == uid; allow write: if false; }
  match /communities/{id} {
   allow read: if member(id); allow write: if false;
   match /members/{uid} { allow read: if member(id); allow write: if false; match /tokens/{token} { allow read, write: if false; } }
  }
  match /vehicles/{id} {
   allow read: if member(resource.data.communityId);
   allow create: if member(request.resource.data.communityId)
    && request.resource.data.keys().hasOnly(['communityId','createdBy','plate','owner','model','color','photo','timestamp'])
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.plate is string && request.resource.data.plate.matches('^[A-Z]{3}-[0-9]{4}$')
    && request.resource.data.owner is string && request.resource.data.owner.size() > 0 && request.resource.data.owner.size() <= 80
    && request.resource.data.model is string && request.resource.data.model.size() <= 80
    && request.resource.data.color is string && request.resource.data.color.size() <= 40
    && request.resource.data.photo is string && request.resource.data.photo.size() < 4096
    && request.resource.data.timestamp == request.time;
   allow update, delete: if false;
  }
  match /alerts/{id} {
   allow read: if member(resource.data.communityId);
   allow update: if admin(resource.data.communityId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) && request.resource.data.status == 'Resuelta';
   allow create, delete: if false;
  }
  match /unrecognized_sightings/{id} { allow read: if member(resource.data.communityId); allow write: if false; }
  match /sighting_logs/{id} { allow read: if member(resource.data.communityId); allow write: if false; }
  match /{document=**} { allow read, write: if false; }
 }
}
